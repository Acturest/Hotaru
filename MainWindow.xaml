<Window x:Class="FloatingTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="悬浮翻译器"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="False" AllowDrop="True"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        SnapsToDevicePixels="False" UseLayoutRounding="False"
        Width="1920" Height="1080" Left="0" Top="0">

  <Canvas x:Name="Root" ClipToBounds="False">

    <!-- ================= 悬浮圆钮 ================= -->
    <!-- 说明：这里不再画任何发光（既不发光晕，也不用 DropShadowEffect）。
         原因：光晕比 64×64 的容器大，会被容器边界裁掉，四角只剩一层很淡的青蓝色，
         看上去就是「圆形按钮后面垫了一个矩形半透明底」；DropShadowEffect 的模糊
         表面同样是在包围盒上做的，也会糊出一个方框。 -->
    <Grid x:Name="OrbHost" Width="64" Height="64" Canvas.Left="0" Canvas.Top="0"
          Background="Transparent" Cursor="Hand" ToolTip="点击打开翻译器，拖动可移动位置"
          RenderTransformOrigin="0.5,0.5">
      <!-- 缩放：静止/鼠标离开时略小，鼠标经过或翻译器已打开时回到原大小（见 ORB_SCALE_IDLE / ORB_SCALE_ON） -->
      <Grid.RenderTransform>
        <ScaleTransform x:Name="OrbScale" ScaleX="0.82" ScaleY="0.82"/>
      </Grid.RenderTransform>
      <Ellipse Width="64" Height="64" Fill="{StaticResource OrbBrush}"
               Stroke="#595EEAD4" StrokeThickness="1"/>
      <Path x:Name="OrbIcon" Width="26" Height="26" Stretch="Uniform"
            Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Fill="Transparent" IsHitTestVisible="False"
            Data="M5,8 L11,14 M4,14 L10,8 L12,5 M2,5 H14 M7,2 H8 M22,22 L17,12 L12,22 M14,18 H20"/>
    </Grid>

    <!-- ================= 设置小圆钮 ================= -->
    <Grid x:Name="SettingsBtnHost" Width="34" Height="34" Canvas.Left="0" Canvas.Top="0"
          Background="Transparent" Cursor="Hand" Visibility="Collapsed" Opacity="0">
      <Ellipse Fill="#EB141824" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1"/>
      <Path x:Name="SettingsBtnIcon" Width="15" Height="15" Stretch="Uniform"
            Stroke="{StaticResource MutedBrush}" StrokeThickness="2"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Fill="Transparent" IsHitTestVisible="False"
            Data="M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 Z M19.4,15 A1.65,1.65 0 0 0 19.73,16.82 L19.79,16.88 A2,2 0 0 1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0 0 15.08,19.32 A1.65,1.65 0 0 0 14.08,20.83 L14.08,21 A2,2 0 0 1 10.08,21 L10.08,20.91 A1.65,1.65 0 0 0 9,19.4 A1.65,1.65 0 0 0 7.18,19.73 L7.12,19.79 A2,2 0 0 1 4.29,16.96 L4.35,16.9 A1.65,1.65 0 0 0 4.68,15.08 A1.65,1.65 0 0 0 3.17,14.08 L3,14.08 A2,2 0 0 1 3,10.08 L3.09,10.08 A1.65,1.65 0 0 0 4.6,9 A1.65,1.65 0 0 0 4.27,7.18 L4.21,7.12 A2,2 0 0 1 7.04,4.29 L7.1,4.35 A1.65,1.65 0 0 0 8.92,4.68 L9,4.68 A1.65,1.65 0 0 0 10,3.17 L10,3 A2,2 0 0 1 14,3 L14,3.09 A1.65,1.65 0 0 0 15,4.6 A1.65,1.65 0 0 0 16.82,4.27 L16.88,4.21 A2,2 0 0 1 19.71,7.04 L19.65,7.1 A1.65,1.65 0 0 0 19.32,8.92 L19.32,9 A1.65,1.65 0 0 0 20.83,10 L21,10 A2,2 0 0 1 21,14 L20.91,14 A1.65,1.65 0 0 0 19.4,15 Z"/>
    </Grid>

    <!-- ================= 语音识别小圆钮（在设置按钮上面） ================= -->
    <Grid x:Name="AsrBtnHost" Width="34" Height="34" Canvas.Left="0" Canvas.Top="0"
          Background="Transparent" Cursor="Hand" Visibility="Collapsed" Opacity="0"
          ToolTip="实时字幕（日语，本地 CPU）：聆听电脑正在播放的声音，字幕浮在屏幕底部">
      <Ellipse x:Name="AsrBtnBg" Fill="#EB141824" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1"/>
      <Path x:Name="AsrBtnIcon" Width="15" Height="15" Stretch="Uniform"
            Stroke="{StaticResource MutedBrush}" StrokeThickness="2"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Fill="Transparent" IsHitTestVisible="False"
            Data="M4,9 H8 L13,5 V19 L8,15 H4 Z M16,9.5 A3.5,3.5 0 0 1 16,14.5 M18.5,6.5 A8,8 0 0 1 18.5,17.5"/>
    </Grid>

    <!-- ================= 退出小圆钮（跟随设置按钮显示，纯图标） ================= -->
    <Grid x:Name="ExitBtnHost" Width="34" Height="34" Canvas.Left="0" Canvas.Top="0"
          Background="Transparent" Cursor="Hand" Visibility="Collapsed" Opacity="0"
          ToolTip="退出程序">
      <Ellipse x:Name="ExitBtnBg" Fill="#EB141824" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1"/>
      <Path x:Name="ExitBtnIcon" Width="15" Height="15" Stretch="Uniform"
            Stroke="{StaticResource MutedBrush}" StrokeThickness="2"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Fill="Transparent" IsHitTestVisible="False"
            Data="M18.36,6.64 A9,9 0 1 1 5.64,6.64 M12,2 V12"/>
    </Grid>

    <!-- ================= 输入窗口 ================= -->
    <Border x:Name="InputCard" Width="400" Style="{StaticResource CardPanel}" Padding="8"
            Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <ScaleTransform x:Name="InputScale" ScaleX="1" ScaleY="1"/>
      </Border.RenderTransform>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 图片翻译：选了 / 粘贴了 / 拖进来图片时出现（模型直接读图，不需要 OCR） -->
        <Border x:Name="ImageStrip" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,6"
                Background="{StaticResource BtnBrush}" BorderBrush="{StaticResource StrokeLightBrush}"
                BorderThickness="1" CornerRadius="8" Padding="6,4" ToolTip="要翻译的图片（点垃圾桶图标移除）">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" ClipToBounds="True">
              <Image x:Name="ImageThumb" Stretch="UniformToFill"/>
            </Border>
            <TextBlock x:Name="ImageName" Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Name="ImageClearBtn" Grid.Column="2" Width="24" Height="24"
                    Style="{StaticResource IconBtnSmall}" ToolTip="移除图片">
              <Path Width="12" Height="12" Stretch="Uniform" Style="{StaticResource IconPath}"
                    Data="M6,6 L18,18 M18,6 L6,18"/>
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="LangBtn" Grid.Column="0" Style="{StaticResource LangBtn}" ToolTip="目标语言">
          <Path Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource AccentBrush}"
                StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False"
                Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M2,12 H22 M12,2 A15.3,15.3 0 0 1 16,12 A15.3,15.3 0 0 1 12,22 A15.3,15.3 0 0 1 8,12 A15.3,15.3 0 0 1 12,2 Z"/>
        </Button>

        <Grid Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
          <TextBox x:Name="InputBox" Style="{StaticResource HiddenBox}"
                   TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="96"
                   VerticalScrollBarVisibility="Auto"/>
          <TextBlock x:Name="InputPlaceholder" Text="输入或粘贴文本…"
                     Foreground="{StaticResource PlaceholderBrush}" FontSize="14"
                     IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>

        <!-- 右侧四颗按钮：一行的输入框时排成一行，输入框变高（多行）时排成 2×2 格子 -->
        <UniformGrid x:Name="BtnBlock" Grid.Column="2" Rows="1" Columns="4" VerticalAlignment="Center">

        <Button x:Name="ImageBtn" Style="{StaticResource IconBtn}" Margin="3"
                ToolTip="翻译图片（也可 Ctrl+V 粘贴截图、把图片拖进来）">
          <Path Width="16" Height="16" Stretch="Uniform" Style="{StaticResource IconPath}"
                Data="M3,5 H21 A1,1 0 0 1 22,6 V18 A1,1 0 0 1 21,19 H3 A1,1 0 0 1 2,18 V6 A1,1 0 0 1 3,5 Z M2,16 L8,11 L13,15 L17,12 L22,16 M16,9 A1.6,1.6 0 1 1 16,8.9 Z"/>
        </Button>

        <Button x:Name="PasteBtn" Style="{StaticResource IconBtn}" Margin="3"
                ToolTip="粘贴并翻译（剪贴板里是图片就直接翻图片）">
          <Path Width="16" Height="16" Stretch="Uniform" Style="{StaticResource IconPath}"
                Data="M16,4 H18 A2,2 0 0 1 20,6 V20 A2,2 0 0 1 18,22 H6 A2,2 0 0 1 4,20 V6 A2,2 0 0 1 6,4 H8 M8,2 H16 V6 H8 Z"/>
        </Button>

        <Button x:Name="TranslateBtn" Style="{StaticResource TranslateBtn}" Margin="3"
                ToolTip="翻译 (Enter)">
          <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AccentBrush}"
                StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                StrokeLineJoin="Round" Fill="Transparent" IsHitTestVisible="False"
                Data="M5,12 H19 M12,5 L19,12 L12,19"/>
        </Button>

        <Button x:Name="ClearBtn" Style="{StaticResource IconBtn}" Margin="3"
                ToolTip="清空 (Esc)">
          <Path Width="16" Height="16" Stretch="Uniform" Style="{StaticResource IconPath}"
                Data="M3,6 H21 M19,6 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V6 M8,6 V4 A2,2 0 0 1 10,2 H14 A2,2 0 0 1 16,4 V6 M10,11 V17 M14,11 V17"/>
        </Button>

        </UniformGrid>
        </Grid>
      </Grid>
    </Border>

    <!-- ================= 结果窗口 ================= -->
    <Border x:Name="ResultCard" Width="400" Style="{StaticResource CardPanel}" Padding="14"
            Visibility="Collapsed" Opacity="0" MinHeight="120" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <TransformGroup>
          <TranslateTransform x:Name="ResultShift" Y="-8"/>
          <ScaleTransform x:Name="ResultScale" ScaleX="0.96" ScaleY="0.96"/>
        </TransformGroup>
      </Border.RenderTransform>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ResultScroll" Grid.Row="0" MaxHeight="196"
                      Style="{StaticResource ThinScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <!-- 用只读 TextBox 而不是 TextBlock：点词查词需要 GetCharacterIndexFromPoint 做字符命中 -->
          <TextBox x:Name="ResultText" Foreground="{StaticResource ResultTextBrush}"
                   FontSize="14" TextWrapping="Wrap" IsReadOnly="True" IsTabStop="False"
                   Focusable="False" IsReadOnlyCaretVisible="False"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                   AcceptsReturn="True" Cursor="IBeam"/>
        </ScrollViewer>

        <!-- 同语言翻译（如 日→日）时，「中」按钮补出来的中文对照，单独占一行 -->
        <Border x:Name="CnRow" Grid.Row="1" Visibility="Collapsed"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Margin="0,10,0,0" Padding="0,8,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="中" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,2,8,0"/>
            <TextBlock x:Name="CnText" Grid.Column="1" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{StaticResource ResultTextBrush}"/>
          </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Margin="0,10,0,0" Padding="0,8,0,0">
          <Grid>
            <TextBlock x:Name="ResultMeta" HorizontalAlignment="Left" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                       Foreground="{StaticResource DimBrush}" FontSize="11"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- 同语言翻译（日→日等）时点它把结果补译成中文，额外一行显示 -->
            <Button x:Name="CnBtn" Style="{StaticResource IconBtnSmall}" Margin="0,0,6,0"
                    Visibility="Collapsed" ToolTip="把结果翻译成中文（在上方加一行）">
              <TextBlock x:Name="CnIcon" Text="中" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}" IsHitTestVisible="False"/>
            </Button>
            <!-- 第三方语音：本地 Irodori-TTS，只在目标语言为日语时出现（和系统朗读按钮并存） -->
            <Button x:Name="IrodoriBtn" Style="{StaticResource IconBtnSmall}" Margin="0,0,6,0"
                    Visibility="Collapsed" ToolTip="用本地 Irodori-TTS 朗读（日语）">
              <TextBlock x:Name="IrodoriIcon" Text="あ" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}" IsHitTestVisible="False"/>
            </Button>
            <!-- 重播：把上一轮用 Irodori-TTS 生成的那几段再放一遍（不用重新合成） -->
            <Button x:Name="ReplayBtn" Style="{StaticResource IconBtnSmall}" Margin="0,0,6,0"
                    Visibility="Collapsed" ToolTip="重播上一轮生成的语音（不重新合成）"
                    Click="ReplayBtn_Click">
              <TextBlock x:Name="ReplayIcon" Text="↻" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}" IsHitTestVisible="False"/>
            </Button>
            <Button x:Name="SpeakBtn" Style="{StaticResource IconBtnSmall}" ToolTip="朗读译文">
              <Path Width="14" Height="14" Stretch="Uniform" Style="{StaticResource MiniIconPath}"
                    Data="M11,5 L6,9 H2 V15 H6 L11,19 Z M19.07,4.93 A10,10 0 0 1 19.07,19.07 M15.54,8.46 A5,5 0 0 1 15.54,15.53"/>
            </Button>
            <Button x:Name="CopyBtn" Style="{StaticResource IconBtnSmall}" Margin="6,0,0,0" ToolTip="复制译文">
              <Path Width="14" Height="14" Stretch="Uniform" Style="{StaticResource MiniIconPath}"
                    Data="M9,9 H20 A2,2 0 0 1 22,11 V20 A2,2 0 0 1 20,22 H11 A2,2 0 0 1 9,20 V11 A2,2 0 0 1 11,9 Z M5,15 H4 A2,2 0 0 1 2,13 V4 A2,2 0 0 1 4,2 H13 A2,2 0 0 1 15,4 V5"/>
            </Button>
          </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- ================= 实时字幕卡（屏幕底部） ================= -->
    <Border x:Name="AsrCard" Width="640" Style="{StaticResource PopupPanel}" Padding="12"
            Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <ScaleTransform x:Name="AsrScale" ScaleX="0.95" ScaleY="0.95"/>
      </Border.RenderTransform>
      <StackPanel>
        <Grid>
          <TextBlock Text="实时字幕 · 日语（本地 CPU）" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource TxtBrush}" VerticalAlignment="Center"/>
          <Button x:Name="AsrCloseBtn" Style="{StaticResource IconBtnSmall}" Width="22" Height="22"
                  HorizontalAlignment="Right" ToolTip="关闭">
            <Path Width="10" Height="10" Stretch="Uniform" Style="{StaticResource MiniIconPath}"
                  Data="M5,5 L19,19 M19,5 L5,19"/>
          </Button>
        </Grid>
        <TextBlock x:Name="AsrStatus" Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"
                   Text="点麦克风按钮听电脑播放的声音；每条字幕上日文、下中文，点词可查词典。"/>
        <ScrollViewer x:Name="AsrTextScroll" MaxHeight="168" Margin="0,8,0,0" Visibility="Collapsed"
                      Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="AsrText" FontFamily="Yu Gothic UI, Meiryo, Microsoft YaHei UI"
                     FontSize="21" TextWrapping="Wrap" LineHeight="32"
                     LineStackingStrategy="BlockLineHeight"
                     Foreground="{StaticResource ResultTextBrush}"/>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="AsrActionBtn" Content="开始聆听" Style="{StaticResource TextBtn}"/>
          <Button x:Name="AsrTranslateBtn" Content="翻译字幕" Style="{StaticResource TextBtn}" Margin="8,0,0,0"/>
          <Button x:Name="AsrSettingsBtn" Content="模型与词典" Style="{StaticResource TextBtn}" Margin="8,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ================= 点词查词浮层 ================= -->
    <Border x:Name="DictPanel" Width="340" Style="{StaticResource PopupPanel}" Padding="14"
            Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <ScaleTransform x:Name="DictScale" ScaleX="0.96" ScaleY="0.96"/>
      </Border.RenderTransform>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,56,0">
            <TextBlock x:Name="DictWord" FontFamily="Yu Gothic UI, Meiryo, Microsoft YaHei UI"
                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TxtBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DictReading" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource AccentBrush}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="DictStarBtn" Style="{StaticResource IconBtnSmall}" Width="22" Height="22"
                    Margin="0,0,2,0" ToolTip="收藏到生词本">
              <Path x:Name="DictStarPath" Width="13" Height="13" Stretch="Uniform"
                    Data="M12,2 L14.9,9.2 L22.5,9.6 L16.6,14.5 L18.5,21.8 L12,17.8 L5.5,21.8 L7.4,14.5 L1.5,9.6 L9.1,9.2 Z"
                    Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                    StrokeLineJoin="Round" Fill="Transparent"/>
            </Button>
            <Button x:Name="DictCloseBtn" Style="{StaticResource IconBtnSmall}" Width="22" Height="22"
                    VerticalAlignment="Top" ToolTip="关闭">
              <Path Width="10" Height="10" Stretch="Uniform" Style="{StaticResource MiniIconPath}"
                    Data="M5,5 L19,19 M19,5 L5,19"/>
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" MaxHeight="320"
                      Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="DictBody"/>
        </ScrollViewer>
        <TextBlock Grid.Row="2" x:Name="DictFoot" Margin="0,10,0,0" FontSize="10.5"
                   TextWrapping="Wrap" Foreground="{StaticResource DimBrush}"/>
      </Grid>
    </Border>

    <!-- ================= 弹出列表（语言 / 设置下拉共用） ================= -->
    <Border x:Name="LangDropdown" Width="180" Style="{StaticResource PopupPanel}" Padding="6"
            Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0">
      <Border.RenderTransform>
        <TranslateTransform x:Name="DropdownShift" Y="-6"/>
      </Border.RenderTransform>
      <ScrollViewer MaxHeight="380" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="LangList"/>
      </ScrollViewer>
    </Border>

    <!-- ================= 设置面板 ================= -->
    <Border x:Name="SettingsPanel" Width="312" Style="{StaticResource PopupPanel}" Padding="12"
            Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <ScaleTransform x:Name="SettingsScale" ScaleX="0.95" ScaleY="0.95"/>
      </Border.RenderTransform>
      <DockPanel>
        <!-- 分栏标签：翻译 / 自动化 / 语音 / 字幕 / 界面（按钮在代码里建，见 BuildSettingsTabs） -->
        <Grid x:Name="SettingsTabs" DockPanel.Dock="Top" Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>
        </Grid>
        <ScrollViewer x:Name="SettingsScroll" MaxHeight="432" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto"/>
      </DockPanel>
    </Border>

    <!-- ================= 轻提示 ================= -->
    <!-- IsHitTestVisible=False：提示条只用来显示，鼠标点击要能穿透到下面的按钮 -->
    <Border x:Name="ToastBox" Style="{StaticResource PopupPanel}" CornerRadius="10" Padding="12,8"
            IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
      <TextBlock x:Name="ToastText" Foreground="{StaticResource TxtBrush}" FontSize="12"/>
    </Border>
  </Canvas>
</Window>
