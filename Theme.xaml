<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ 基础 ============ -->
  <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, Inter</FontFamily>

  <SolidColorBrush x:Key="PanelBrush"      Color="#F2161A26"/>
  <SolidColorBrush x:Key="PopupBrush"      Color="#FC11141E"/>
  <SolidColorBrush x:Key="TxtBrush"        Color="#FFE8ECF5"/>
  <SolidColorBrush x:Key="MutedBrush"      Color="#FF8891A8"/>
  <SolidColorBrush x:Key="DimBrush"        Color="#FF555C72"/>
  <SolidColorBrush x:Key="AccentBrush"     Color="#FF5EEAD4"/>
  <SolidColorBrush x:Key="Accent2Brush"    Color="#FF7C8CFF"/>
  <SolidColorBrush x:Key="StrokeBrush"     Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="StrokeLightBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="DividerBrush"    Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="BtnBrush"        Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="BtnHoverBrush"   Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="FieldBrush"      Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="FieldHoverBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#38FFFFFF"/>
  <SolidColorBrush x:Key="ResultTextBrush" Color="#FFC8D3FF"/>
  <SolidColorBrush x:Key="OkBrush"         Color="#FF5EEAD4"/>
  <SolidColorBrush x:Key="ErrBrush"        Color="#FFF87171"/>

  <LinearGradientBrush x:Key="OrbBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF1A1E2C" Offset="0"/>
    <GradientStop Color="#FF0F121B" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="AccentGradBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF5EEAD4" Offset="0"/>
    <GradientStop Color="#FF7C8CFF" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="AccentSoftBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#335EEAD4" Offset="0"/>
    <GradientStop Color="#337C8CFF" Offset="1"/>
  </LinearGradientBrush>

  <RadialGradientBrush x:Key="OrbGlowBrush">
    <GradientStop Color="#005EEAD4" Offset="0"/>
    <GradientStop Color="#4D5EEAD4" Offset="0.54"/>
    <GradientStop Color="#1F7C8CFF" Offset="0.74"/>
    <GradientStop Color="#007C8CFF" Offset="1"/>
  </RadialGradientBrush>

  <!-- ============ 卡片 ============ -->
  <Style x:Key="CardPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="SnapsToDevicePixels" Value="False"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#FF000000" BlurRadius="30" ShadowDepth="10"
                          Direction="270" Opacity="0.55" RenderingBias="Quality"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PopupPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PopupBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#FF000000" BlurRadius="26" ShadowDepth="8"
                          Direction="270" Opacity="0.6" RenderingBias="Quality"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ 按钮模板 ============ -->
  <ControlTemplate x:Key="RoundBtnTemplate" TargetType="Button">
    <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="bd" Property="Background" Value="{StaticResource BtnHoverBrush}"/>
        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="AccentBtnTemplate" TargetType="Button">
    <Border x:Name="bd" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
            BorderBrush="#805EEAD4" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect Color="#FF5EEAD4" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
      </Border.Effect>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGradBrush}"/>
        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter TargetName="bd" Property="Effect">
          <Setter.Value>
            <DropShadowEffect Color="#FF5EEAD4" BlurRadius="22" ShadowDepth="0" Opacity="0.65"/>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="IconBtn" TargetType="Button">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="{StaticResource BtnBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource StrokeLightBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template" Value="{StaticResource RoundBtnTemplate}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <Style x:Key="IconBtnSmall" TargetType="Button" BasedOn="{StaticResource IconBtn}">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
  </Style>

  <Style x:Key="LangBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
    <Setter Property="Width" Value="38"/>
    <Setter Property="Height" Value="38"/>
  </Style>

  <Style x:Key="TranslateBtn" TargetType="Button">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template" Value="{StaticResource AccentBtnTemplate}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <Style x:Key="TextBtn" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="{StaticResource BtnBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource StrokeLightBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource BtnHoverBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TxtBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ 图标 ============ -->
  <Style x:Key="IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{StaticResource MutedBrush}"/>
    <Setter Property="StrokeThickness" Value="1.8"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Fill" Value="Transparent"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <Style x:Key="MiniIconPath" TargetType="Path" BasedOn="{StaticResource IconPath}">
    <Setter Property="StrokeThickness" Value="1.6"/>
  </Style>

  <!-- ============ 输入控件 ============ -->
  <!-- 输入框专用的更细滚动条：样式跟设置面板一致（同色同触发），只是更窄。
       注意：这两个样式必须写在 HiddenBox 之前 —— 模板里的 StaticResource 是解析期查找的。 -->
  <Style x:Key="ThinnerScroll" TargetType="ScrollBar">
    <Setter Property="Width" Value="4"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="tb" CornerRadius="2" Background="#407A8593"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="tb" Property="Background" Value="#805EEAD4"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 输入框专用滚动条：更细（4px），配色与设置面板一致 -->
  <Style x:Key="InputScrollViewer" TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollContentPresenter Grid.Column="0"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                       Style="{StaticResource ThinnerScroll}"
                       Width="4" MinWidth="4" MaxWidth="4"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HiddenBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource TxtBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                        Style="{StaticResource InputScrollViewer}"
                        VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                        HorizontalScrollBarVisibility="Hidden" Margin="{TemplateBinding Padding}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FieldBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource StrokeLightBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource TxtBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                          HorizontalScrollBarVisibility="Hidden" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource FieldHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#805EEAD4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HintText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="RowLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,10,0,4"/>
  </Style>

  <!-- ============ 复选框 / 滑块 ============ -->
  <Style x:Key="GlassCheck" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="15" Height="15" CornerRadius="4"
                    Background="{StaticResource FieldBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Path x:Name="tick" Width="9" Height="9" Stretch="Uniform" Visibility="Collapsed"
                    Stroke="{StaticResource AccentBrush}" StrokeThickness="2.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M1,5 L4.2,8.4 L10,1.6"/>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              <Setter TargetName="box" Property="BorderBrush" Value="#805EEAD4"/>
              <Setter TargetName="box" Property="Background" Value="#1F5EEAD4"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="#66FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GlassSlider" TargetType="Slider">
    <Setter Property="Height" Value="20"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="3" CornerRadius="2" Background="{StaticResource FieldHoverBrush}"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="13" Height="13">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Fill="{StaticResource AccentBrush}">
                        <Ellipse.Effect>
                          <DropShadowEffect Color="#FF5EEAD4" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                        </Ellipse.Effect>
                      </Ellipse>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ 滚动条 ============ -->
  <Style x:Key="ThinScroll" TargetType="ScrollBar">
    <Setter Property="Width" Value="6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="tb" CornerRadius="3" Background="#407A8593" Margin="1,0"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="tb" Property="Background" Value="#805EEAD4"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollContentPresenter Grid.Column="0"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                       Style="{StaticResource ThinScroll}"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
