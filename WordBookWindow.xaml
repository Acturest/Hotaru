<Window x:Class="FloatingTranslator.WordBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="生词本"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="True"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Width="470" Height="480">

  <Border Style="{StaticResource CardPanel}" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="Header" Grid.Row="0" Background="Transparent" Margin="0,0,0,10">
        <TextBlock Text="生词本" Foreground="{StaticResource TxtBrush}" FontSize="13"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="CountText" HorizontalAlignment="Right" Margin="0,0,34,0"
                   Foreground="{StaticResource DimBrush}" FontSize="11" VerticalAlignment="Center"/>
        <Button x:Name="CloseBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                Style="{StaticResource IconBtnSmall}" ToolTip="关闭">
          <Path Width="12" Height="12" Stretch="Uniform" Style="{StaticResource MiniIconPath}"
                Data="M4,4 L20,20 M20,4 L4,20"/>
        </Button>
      </Grid>

      <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource FieldBox}"
               Margin="0,0,0,10" Height="30"/>

      <ScrollViewer x:Name="Scroll" Grid.Row="2" Style="{StaticResource ThinScrollViewer}"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ListHost" Margin="0,0,8,0"/>
      </ScrollViewer>

      <Grid Grid.Row="3" Margin="0,10,0,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="SpeakBtn" Content="朗读" Style="{StaticResource TextBtn}"
                  Foreground="{StaticResource AccentBrush}" Padding="14,5,14,5"/>
          <Button x:Name="DelBtn" Content="删除" Style="{StaticResource TextBtn}" Margin="8,0,0,0"/>
          <Button x:Name="ExportBtn" Content="导出 CSV" Style="{StaticResource TextBtn}" Margin="8,0,0,0"/>
          <Button x:Name="ClearBtn" Content="清空" Style="{StaticResource TextBtn}" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="EmptyText" Text="还没有收藏的词" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Foreground="{StaticResource DimBrush}" FontSize="11"/>
      </Grid>
    </Grid>
  </Border>
</Window>
